<list comprehension> ::= "[" <list element source> [ <list element filter and projection> ] "]" 
<list element filter and projection> ::= [ <list element filter> ] <list element projection> | <list element filter> 
<list element source> ::= xref:syntax/variables.adoc[<binding variable>] "IN" xref:expressions/index.adoc[<value expression>] 
<list element filter> ::= "WHERE" xref:expressions/index.adoc[<value expression>] 
<list element projection> ::= "|" xref:expressions/index.adoc[<value expression>]