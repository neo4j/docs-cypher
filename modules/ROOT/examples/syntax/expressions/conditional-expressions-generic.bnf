<search case> ::= "CASE" <searched when clause> ...[ <else clause> ] "END" 
<else clause> ::= "ELSE" xref:expressions/index.adoc[<value expression>] 
<searched when clause> ::= "WHEN" xref:expressions/predicates/boolean-operators.adoc[<search condition>] "THEN" xref:expressions/index.adoc[<value expression>]