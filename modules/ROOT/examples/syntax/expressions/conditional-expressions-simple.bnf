<simple case> ::= "CASE" <case operand> <simple when clause> ...[ <else clause> ] "END" 
<else clause> ::= "ELSE" xref:expressions/index.adoc[<value expression>] 
<case operand> ::= xref:expressions/index.adoc[<value expression>] 
<simple when clause> ::= "WHEN" <when operand list> "THEN" xref:expressions/index.adoc[<value expression>] 
<when operand list> ::= <when operand> [{ "," <when operand> }...] 
<when operand> ::= xref:expressions/predicates/comparison-operators.adoc[<simple comparison predicate part 2>] | xref:expressions/predicates/index.adoc[<advanced comparison predicate part 2>] | xref:expressions/index.adoc[<value expression>]