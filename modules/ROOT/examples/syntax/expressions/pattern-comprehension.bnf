<pattern comprehension> ::= "[" <pattern source> <pattern filter and projection> "]" 
<pattern source> ::= [ xref:syntax/variables.adoc[<binding variable>] "=" ] xref:patterns/fixed-length-paths.adoc[<simple path pattern>] 
<pattern filter and projection> ::= [ <pattern filter> ] <pattern projection> 
<pattern filter> ::= "WHERE" xref:expressions/index.adoc[<value expression>] 
<pattern projection> ::= "|" xref:expressions/index.adoc[<value expression>]