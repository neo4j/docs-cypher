<comparison predicate> ::= <simple comparison predicand> [ <simple comparison predicate part 2> ...] 
<simple comparison predicate part 2> ::= <simple comp op> <advanced comparison predicand> 
<simple comparison predicand> ::= <advanced comparison predicand> [ <advanced comparison predicate part 2> ] 
<simple comp op> ::= "=" | <not equals operator> | <less than operator> | <greater than operator> | <less than or equals operator> | <greater than or equals operator> 
<advanced comparison predicand> ::= xref:expressions/mathematical-operators.adoc[<arithmetic value expression>] 
<advanced comparison predicate part 2> ::= xref:expressions/predicates/string-operators.adoc[<advanced comp op>] <advanced comparison predicand> | xref:expressions/predicates/type-predicate-expressions.adoc[<value type predicate part 2>] | <null predicate part 2> | xref:expressions/predicates/string-operators.adoc[xref:expressions/predicates/string-operators.adoc[<normalized predicate part 2>]] | xref:expressions/predicates/label-expression-predicates.adoc[<is labeled predicate part 2>] 
<not equals operator> ::= "<>" 
<less than operator> ::= "<" 
<greater than operator> ::= ">" 
<less than or equals operator> ::= "<=" 
<greater than or equals operator> ::= ">=" 
<null predicate part 2> ::= "IS" [ "NOT" ] "NULL"