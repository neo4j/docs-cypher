<map projection> ::= xref:syntax/variables.adoc[<binding variable>] "{" [ <map projection element list> ] "}" 
<map projection element list> ::= <map projection element> [{ "," <map projection element> }...] 
<map projection element> ::= <literal map field> | <field selector> | <variable selector> | <all fields selector> 
<literal map field> ::= xref:syntax/naming.adoc#recommendations[<property name>] ":" xref:expressions/index.adoc[<value expression>] 
<field selector> ::= xref:expressions/node-relationship-operators.adoc[<static property reference>] 
<variable selector> ::= xref:syntax/variables.adoc[<binding variable>] 
<all fields selector> ::= "." "*"