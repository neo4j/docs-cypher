<map projection> ::= xref:queries/variables-and-parameters.adoc#variables[<binding variable>] "{" [ <map projection element list> ] "}" 
<map projection element list> ::= <map projection element> [{ "," <map projection element> }...] 
<map projection element> ::= <literal map field> | <field selector> | <variable selector> | <all fields selector> 
<literal map field> ::= xref:appendix/styleguide.adoc#naming-rules[<property name>] ":" xref:expressions/index.adoc[<value expression>] 
<field selector> ::= xref:expressions/node-relationship-operators.adoc#static-property-access[<static property reference>] 
<variable selector> ::= xref:queries/variables-and-parameters.adoc#variables[<binding variable>] 
<all fields selector> ::= "." "*"