<arithmetic value expression> ::= <arithmetic term> | <arithmetic value expression> <plus sign> <arithmetic term> | <arithmetic value expression> "-" <arithmetic term> | <arithmetic value expression> xref:expressions/string-operators.adoc[<concatenation operator>] <arithmetic term> 
<arithmetic term> ::= <arithmetic factor> | <arithmetic term> "*" <arithmetic factor> | <arithmetic term> "/" <arithmetic factor> | <arithmetic term> "%" <arithmetic factor> 
<plus sign> ::= "+" 
<arithmetic factor> ::= <arithmetic unary> | <arithmetic factor> "^" <arithmetic unary> 
<arithmetic unary> ::= [ <sign> ] xref:expressions/index.adoc[<postfix expression>] 
<sign> ::= <plus sign> | "-"