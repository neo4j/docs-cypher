<with statement> ::= "WITH" <return statement body> [ <order by and page clause> ][ xref:clauses/where.adoc[<where clause>] ] 
<return statement body> ::= [ <set quantifier> ] <return item list> [ <group by clause> ] 
<return item list> ::= { "*" | <return item> }[{ "," <return item> }...] 
<return item> ::= xref:expressions/index.adoc[<value expression>] [ <return item alias> ] 
<return item alias> ::= "AS" xref:syntax/naming.adoc[<identifier>] 
<order by and page clause> ::= xref:clauses/order-by.adoc[<order by clause>] [ <offset clause> ][ xref:clauses/limit.adoc[<limit clause>] ]| <offset clause> [ xref:clauses/limit.adoc[<limit clause>] ]| xref:clauses/limit.adoc[<limit clause>] 
<offset clause> ::= <offset synonym> xref:expressions/index.adoc[<value expression>] 
<offset synonym> ::= "SKIP" | "OFFSET" 
<group by clause> ::= "GROUP BY" <grouping element list> 
<grouping element list> ::= <grouping element> [{ "," <grouping element> }...]| <empty grouping set> | "ALL" 
<grouping element> ::= xref:expressions/index.adoc[<value expression>] 
<empty grouping set> ::= "(" ")" 
<set quantifier> ::= "ALL" | "DISTINCT"