<merge statement> ::= "MERGE" <merge graph pattern> [ <merge action> ] 
<merge action> ::= "ON" { "MATCH" | "CREATE" } xref:clauses/set.adoc[<set statement>] 
<merge graph pattern> ::= <merge path pattern> 
<merge path pattern> ::= [ <path variable declaration> ] <merge node pattern> [{ <merge relationship pattern> <merge node pattern> }...] 
<merge relationship pattern> ::= <merge relationship pointing left> | <merge relationship pointing right> 
<merge node pattern> ::= "(" [ <merge node pattern filler> ] ")" 
<path variable declaration> ::= xref:syntax/naming.adoc[<binding variable>] "=" 
<merge relationship pointing left> ::= <left arrowhead> <arrow line> "[" <merge relationship pattern filler> "]" <arrow line> 
<merge relationship pointing right> ::= <arrow line> "[" <merge relationship pattern filler> "]" <arrow line> <right arrowhead> 
<left arrowhead> ::= "<" 
<arrow line> ::= "-" 
<right arrowhead> ::= ">"