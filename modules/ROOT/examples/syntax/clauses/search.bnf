<search clause> ::= "SEARCH" xref:syntax/naming.adoc[<binding variable reference>] "IN" "(" <index specification clause> <for clause> [ xref:clauses/where.adoc[<where clause>] ][ <offset clause> ] xref:clauses/limit.adoc[<limit clause>] ")" [ <score clause> ] 
<offset clause> ::= <offset synonym> xref:expressions/index.adoc[<value expression>] 
<score clause> ::= "SCORE AS" xref:syntax/naming.adoc[<binding variable>] 
<index specification clause> ::= { "VECTOR" | "FULLTEXT" } "INDEX" <index name specification> 
<for clause> ::= "FOR" xref:expressions/index.adoc[<value expression>] [ "WITH ANALYZER" xref:expressions/index.adoc[<value expression>] ] 
<offset synonym> ::= "SKIP" | "OFFSET" 
<index name specification> ::= <index name> | <general parameter reference> 
<index name> ::= xref:syntax/naming.adoc[<identifier>] 
<general parameter reference> ::= "$" xref:syntax/parameters.adoc[<parameter name>]