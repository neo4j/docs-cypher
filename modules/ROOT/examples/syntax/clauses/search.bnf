<search clause> ::= 
  "SEARCH" link:https://neo4j.com/docs/cypher-manual/current/syntax/naming/[<binding variable>] "IN" "(" "VECTOR INDEX" <index name> "FOR" link:https://neo4j.com/docs/cypher-manual/current/expressions/[<value expression>] [ "WHERE" <search condition> ] "LIMIT" link:https://neo4j.com/docs/cypher-manual/current/expressions/[<value expression>] ")" [ "SCORE AS" link:https://neo4j.com/docs/cypher-manual/current/syntax/naming/[<binding variable>] ]