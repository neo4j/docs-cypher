<order by clause> ::= "ORDER BY" <sort specification list> 
<sort specification list> ::= <sort specification> [{ "," <sort specification> }...] 
<sort specification> ::= <sort key> [ <ordering specification> ] 
<ordering specification> ::= <ascending order> | <descending order> 
<sort key> ::= xref:expressions/index.adoc[<value expression>] 
<ascending order> ::= "ASC" | "ASCENDING" 
<descending order> ::= "DESC" | "DESCENDING"