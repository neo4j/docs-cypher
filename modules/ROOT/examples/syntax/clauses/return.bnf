<return statement> ::= "RETURN" <return statement body> [ <order by and page clause> ] 
<order by and page clause> ::= xref:clauses/order-by.adoc[<order by clause>] [ xref:clauses/skip.adoc[<offset clause>] ][ xref:clauses/limit.adoc[<limit clause>] ]| xref:clauses/skip.adoc[<offset clause>] [ xref:clauses/limit.adoc[<limit clause>] ]| xref:clauses/limit.adoc[<limit clause>] 
<return statement body> ::= [ <set quantifier> ] <return item list> [ xref:clauses/group-by.adoc[<group by clause>] ] 
<set quantifier> ::= "ALL" | "DISTINCT" 
<return item list> ::= { "*" | <return item> }[{ "," <return item> }...] 
<return item> ::= xref:expressions/index.adoc[<value expression>] [ <return item alias> ] 
<return item alias> ::= "AS" xref:syntax/naming.adoc[<identifier>]