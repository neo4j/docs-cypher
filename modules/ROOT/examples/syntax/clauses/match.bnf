<simple match statement> ::= 
  "MATCH" [ <match mode> ] <path pattern> [ { "," <path pattern> }... ] [ "WHERE" <search condition> [ <search clause> ] | <search clause> [ "WHERE" <search condition> ] ]

<match mode> ::= 
    "REPEATABLE" { "ELEMENT" [ "BINDINGS" ] | "ELEMENTS" }
  | "DIFFERENT" { "RELATIONSHIP" [ "BINDINGS" ] | "RELATIONSHIPS" }