<simple match statement> ::= "MATCH" <graph pattern binding table> 
<graph pattern binding table> ::= <graph pattern> 
<graph pattern> ::= [ <match mode> ] <path pattern list> [ <hints> ][ <graph pattern where and search clause> ] 
<hints> ::= <hint> [ <hints> ] 
<hint> ::= "USING" <hint specification> 
<hint specification> ::= <index hint specification> | "JOIN ON" <binding variable reference list> | "SCAN" xref:syntax/naming.adoc[<binding variable>] <label or rel type> 
<index hint specification> ::= [ <index type> ] "INDEX" [ "SEEK" ] xref:syntax/naming.adoc[<binding variable>] <label or rel type> "(" <property name list> ")" 
<index type> ::= "TEXT" | "RANGE" | "POINT" 
<label or rel type> ::= ":" <label name> 
<graph pattern where and search clause> ::= <graph pattern where clause> [ xref:clauses/search.adoc[<search clause>] ]| xref:clauses/search.adoc[<search clause>] [ <graph pattern where clause> ] 
<match mode> ::= <repeatable elements match mode> | <different edges match mode> 
<repeatable elements match mode> ::= "REPEATABLE" <element bindings or elements> 
<different edges match mode> ::= "DIFFERENT" <edge bindings or edges> 
<element bindings or elements> ::= "ELEMENT" [ "BINDINGS" ]| "ELEMENTS" 
<edge bindings or edges> ::= "RELATIONSHIP" [ "BINDINGS" ]| "RELATIONSHIPS" 
<path pattern list> ::= xref:patterns/reference/path-patterns-and-graph-patterns.adoc[<path pattern>] [{ "," xref:patterns/reference/path-patterns-and-graph-patterns.adoc[<path pattern>] }...] 
<graph pattern where clause> ::= xref:clauses/where.adoc[<where clause>] 
<label name> ::= xref:syntax/naming.adoc[<identifier>] 
<property name list> ::= <property name> [{ "," <property name> }...] 
<property name> ::= xref:syntax/naming.adoc[<identifier>] 
<binding variable reference> ::= xref:syntax/naming.adoc[<binding variable>] 
<binding variable reference list> ::= <binding variable reference> [{ "," <binding variable reference> }...]