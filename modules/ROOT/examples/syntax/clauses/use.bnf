<use graph clause> ::= "USE" <graph expression> 
<graph expression> ::= "(" <graph expression> ")" | <graph reference> | <function invocation> 
<set quantifier> ::= "ALL" | "DISTINCT" 
<graph reference> ::= [ <regular catalog object parent reference> ] <regular graph name> | <graph name> 
<function reference> ::= [ <catalog object parent reference> ] <function name> 
<catalog object parent reference> ::= { <object name> "." }... 
<regular catalog object parent reference> ::= { <regular object name> "." }... 
<function invocation> ::= <function reference> "(" [ <set quantifier> ][ <function argument list> ] ")" 
<function argument list> ::= <function argument> [{ "," <function argument> }...] 
<function argument> ::= xref:expressions/index.adoc[<value expression>] 
<function name> ::= xref:syntax/naming.adoc[<identifier>]